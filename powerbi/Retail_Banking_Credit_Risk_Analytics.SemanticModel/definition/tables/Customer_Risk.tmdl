table Customer_Risk
	lineageTag: a8873bb3-49f5-4e50-b06b-c5469942011a

	measure 'Total Customers' =
			
			COUNTROWS('Customer_Risk')
		formatString: #,##0
		lineageTag: be7a6948-85ba-4842-b901-cd4e88271bbe

	measure 'Defaulted Customers' =
			
			CALCULATE(
			    [Total Customers],
			    'Customer_Risk'[default payment next month] = 1
			)
		formatString: #,##0
		lineageTag: 936e67a5-20bc-43a7-b1e1-5d65b95db814

	measure 'Observed Default Rate' =
			
			DIVIDE(
			    [Defaulted Customers],
			    [Total Customers],
			    0
			)
		formatString: 0.00%
		lineageTag: be28b962-fa89-4a23-a226-d1914478c81e

	measure 'Total Credit Limit' =
			
			SUM('Customer_Risk'[LIMIT_BAL])
		formatString: #,##0 "NT$"
		lineageTag: 2cc1efbe-d8f9-4242-846a-3204c6062dfb

	measure 'Average Credit Limit' =
			
			AVERAGE('Customer_Risk'[LIMIT_BAL])
		formatString: #,##0 "NT$"
		lineageTag: fd493215-f4ea-4911-a5db-3b44ccf7b28c

	measure 'Average 6M Bill' =
			
			AVERAGE('Customer_Risk'[Avg_Bill_6M])
		formatString: #,##0 "NT$"
		lineageTag: b0373140-3b4b-4502-9ba9-bac2508d8306

	measure 'Average 6M Payment' =
			
			AVERAGE('Customer_Risk'[Avg_Payment_6M])
		formatString: #,##0 "NT$"
		lineageTag: 05c93958-a049-4d2b-aa4f-a2d6acf00673

	measure 'Average Latest Utilization' =
			
			AVERAGE('Customer_Risk'[Credit_Utilization])
		formatString: 0.00%
		lineageTag: 5692e57a-341e-459d-ae89-34b51c9be911

	measure 'Customers With Delinquency' =
			
			CALCULATE(
			    [Total Customers],
			    'Customer_Risk'[Delinquency_Count] > 0
			)
		formatString: #,##0
		lineageTag: 426dd886-02e0-4277-be00-a6a37a22fd43

	measure 'Delinquency Rate' =
			
			DIVIDE(
			    [Customers With Delinquency],
			    [Total Customers],
			    0
			)
		formatString: 0.00%
		lineageTag: 33193b3f-c1bf-4fd2-9b50-1e65981570e7

	measure 'Positive-Bill Customers' =
			CALCULATE(
			    [Total Customers],
			    'Customer_Risk'[BILL_AMT1] > 0
			)
		formatString: #,##0
		lineageTag: 0f7cb81c-afa4-46f1-928f-c7393cc4006d

	measure 'Positive-Bill No Payment' =
			
			CALCULATE(
			    [Total Customers],
			    'Customer_Risk'[BILL_AMT1] > 0,
			    'Customer_Risk'[PAY_AMT1] = 0
			)
		formatString: #,##0
		lineageTag: a23f0ec5-c833-48e8-827a-c9136f7d3029

	measure 'Positive-Bill No-Payment Rate' = DIVIDE([Positive-Bill No Payment], [Positive-Bill Customers], 0)
		formatString: 0.00%
		lineageTag: 778ac164-4176-4282-b936-04787f9c25b0

	measure 'Total Payments 6M' = SUM('Customer_Risk'[PAY_AMT1]) + SUM('Customer_Risk'[PAY_AMT2]) + SUM('Customer_Risk'[PAY_AMT3]) + SUM('Customer_Risk'[PAY_AMT4]) + SUM('Customer_Risk'[PAY_AMT5]) + SUM('Customer_Risk'[PAY_AMT6])
		formatString: #,##0 "NT$"
		lineageTag: f5d91c2a-2876-4c7c-abf0-497b0f745aaf

	measure 'Total Positive Bills 6M' = SUMX('Customer_Risk', IF('Customer_Risk'[BILL_AMT1] > 0, 'Customer_Risk'[BILL_AMT1], 0) + IF('Customer_Risk'[BILL_AMT2] > 0, 'Customer_Risk'[BILL_AMT2], 0) + IF('Customer_Risk'[BILL_AMT3] > 0, 'Customer_Risk'[BILL_AMT3], 0) + IF('Customer_Risk'[BILL_AMT4] > 0, 'Customer_Risk'[BILL_AMT4], 0) + IF('Customer_Risk'[BILL_AMT5] > 0, 'Customer_Risk'[BILL_AMT5], 0) + IF('Customer_Risk'[BILL_AMT6] > 0, 'Customer_Risk'[BILL_AMT6], 0))
		formatString: #,##0 "NT$"
		lineageTag: 7e147f5d-b227-4ec9-bb4c-bf981865c7a3

	measure 'Payment Coverage' = DIVIDE([Total Payments 6M], [Total Positive Bills 6M], 0)
		formatString: 0.00%
		lineageTag: b54b69da-5803-4d09-9cb4-2c1626c7adcd

	measure 'Defaulted Credit-Limit Share' =
			
			DIVIDE(
			    CALCULATE(
			        [Total Credit Limit],
			        REMOVEFILTERS('Customer_Risk'[Default_Label]),
			        'Customer_Risk'[default payment next month] = 1
			    ),
			    CALCULATE(
			        [Total Credit Limit],
			        REMOVEFILTERS(
			            'Customer_Risk'[Default_Label],
			            'Customer_Risk'[default payment next month]
			        )
			    ),
			    0
			)
		formatString: 0.00%
		lineageTag: 37115a99-9d17-4a3c-892f-002152da7001

	measure 'Repeated Delay Customers' =
			
			CALCULATE(
			    [Total Customers],
			    'Customer_Risk'[Delinquency_Count] >= 2
			)
		formatString: #,##0
		lineageTag: 3ae3fe79-36bd-4be2-afe3-df58ff8d2ab2

	measure 'High Exposure Repeated Delay' =
			
			CALCULATE(
			    [Total Customers],
			    'Customer_Risk'[Delinquency_Count] >= 2,
			    'Customer_Risk'[LIMIT_BAL] >= 100000
			)
		formatString: #,##0
		lineageTag: ce4954bc-3b9b-435a-a3fc-78f14339c264

	measure 'Average Maximum Repayment Status' =
			
			AVERAGE('Customer_Risk'[Max_Delinquency_Code])
		formatString: 0.00
		lineageTag: cd82403e-c7ca-4a83-a567-78a241e492a4

	measure 'Default Rate — Payment Behavior' = DIVIDE([Defaulted Customers], [Total Customers], 0)
		formatString: 0.00%
		lineageTag: 70444212-e120-4296-9a83-065c6cb66c8f

	measure 'Portfolio Exposure Share' = DIVIDE([Total Credit Limit], CALCULATE([Total Credit Limit], ALL('Customer_Risk')), 0)
		formatString: 0.00%
		lineageTag: 51ab4b2b-a289-4854-b6af-91d91e7982dc

	measure 'Monthly Avg Positive Bill' =
			
			CALCULATE(
			    AVERAGE(FactRepayment[BillAmount]),
			    FactRepayment[BillAmount] > 0
			)
		formatString: #,##0 "NT$"
		lineageTag: 38c7aaa8-b2e8-4726-8d59-dfc66760506a

	measure 'Monthly Avg Payment' =
			
			AVERAGE(FactRepayment[PaymentAmount])
		formatString: #,##0 "NT$"
		lineageTag: f0524ebd-99b5-4a13-aa3d-2228b3df4e3f

	measure 'Monthly Total Positive Bills' =
			
			SUMX(
			    FactRepayment,
			    IF(
			        FactRepayment[BillAmount] > 0,
			        FactRepayment[BillAmount],
			        0
			    )
			)
		formatString: #,##0 "NT$"
		lineageTag: 2e019728-fd8f-49e6-b4d1-60bc5d03b0d7

	measure 'Monthly Total Payment' =
			
			SUM(FactRepayment[PaymentAmount])
		formatString: #,##0 "NT$"
		lineageTag: 648ee524-40c3-415f-903f-413864db8ccb

	measure 'Monthly Payment Coverage' =
			
			DIVIDE(
			    [Monthly Total Payment],
			    [Monthly Total Positive Bills],
			    0
			)
		formatString: 0.00%
		lineageTag: 34b58c41-a98e-454a-9227-d3b092c79878

	measure 'Monthly Delay Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FactRepayment),
			        FactRepayment[PayStatus] > 0
			    ),
			    COUNTROWS(FactRepayment),
			    0
			)
		formatString: 0.00%
		lineageTag: e676df6a-6e0c-4127-8267-561f6755cfa1

