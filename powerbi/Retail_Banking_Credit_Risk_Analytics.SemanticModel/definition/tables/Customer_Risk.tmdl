	column Utilization_Band
		dataType: string
		lineageTag: ea2c97af-72e3-4ef2-8908-cefee7245233
		summarizeBy: none
		sourceColumn: Utilization_Band
		sortByColumn: 'Utilization Band Sort'

		changedProperty = SortByColumn

	column 'Credit Limit Band Sort' =
			
			SWITCH(
			    TRUE(),
			    'Customer_Risk'[LIMIT_BAL] < 50000, 1,
			    'Customer_Risk'[LIMIT_BAL] < 100000, 2,
			    'Customer_Risk'[LIMIT_BAL] < 200000, 3,
			    'Customer_Risk'[LIMIT_BAL] < 500000, 4,
			    'Customer_Risk'[LIMIT_BAL] >= 500000, 5,
			    99
			)
		formatString: 0
		lineageTag: 0f9c695f-61e9-4d17-bca3-2c05f5e8fb93
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Utilization Band Sort' =
			
			SWITCH(
			    TRUE(),
			    'Customer_Risk'[Credit_Utilization] < 0.25, 1,
			    'Customer_Risk'[Credit_Utilization] < 0.50, 2,
			    'Customer_Risk'[Credit_Utilization] < 0.75, 3,
			    'Customer_Risk'[Credit_Utilization] <= 1.00, 4,
			    'Customer_Risk'[Credit_Utilization] > 1.00, 5,
			    99
			)
		formatString: 0
		lineageTag: 51c06b11-2828-4155-8e45-a32f258608db
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Payment vs Bill Sort' =
			
			SWITCH(
			    TRUE(),
			    'Customer_Risk'[Payment_to_Bill_Ratio_Valid] = 0, 1,
			    'Customer_Risk'[Payment_to_Bill_Ratio_Valid] < 1, 2,
			    'Customer_Risk'[Payment_to_Bill_Ratio_Valid] = 1, 3,
			    'Customer_Risk'[Payment_to_Bill_Ratio_Valid] > 1, 4,
			    99
			)
		formatString: 0
		lineageTag: 04dac3cd-e602-465d-9948-13de15f6318a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Customer_Risk = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(
				    pProjectRoot & "\data\cleaned\banking_credit_risk_cleaned.csv"
				)),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"ID", Int64.Type},
				        {"LIMIT_BAL", type number},
				        {"SEX", Int64.Type},
				        {"EDUCATION", Int64.Type},
				        {"MARRIAGE", Int64.Type},
				        {"AGE", Int64.Type},
				        {"PAY_0", Int64.Type},
				        {"PAY_2", Int64.Type},
				        {"PAY_3", Int64.Type},
				        {"PAY_4", Int64.Type},
				        {"PAY_5", Int64.Type},
				        {"PAY_6", Int64.Type},
				        {"BILL_AMT1", type number},
				        {"BILL_AMT2", type number},
				        {"BILL_AMT3", type number},
				        {"BILL_AMT4", type number},
				        {"BILL_AMT5", type number},
				        {"BILL_AMT6", type number},
				        {"PAY_AMT1", type number},
				        {"PAY_AMT2", type number},
				        {"PAY_AMT3", type number},
				        {"PAY_AMT4", type number},
				        {"PAY_AMT5", type number},
				        {"PAY_AMT6", type number},
				        {"default payment next month", Int64.Type},
				        {"Avg_Bill_6M", type number},
				        {"Avg_Payment_6M", type number},
				        {"Credit_Utilization", type number},
				        {"Payment_to_Bill_Ratio_Valid", type number},
				        {"Bill_Amount_Status", type text},
				        {"Payment_vs_Bill_Status", type text},
				        {"PAY_0_Delayed", Int64.Type},
				        {"PAY_2_Delayed", Int64.Type},
				        {"PAY_3_Delayed", Int64.Type},
				        {"PAY_4_Delayed", Int64.Type},
				        {"PAY_5_Delayed", Int64.Type},
				        {"PAY_6_Delayed", Int64.Type},
				        {"Delinquency_Count", Int64.Type},
				        {"Max_Delinquency_Code", Int64.Type},
				        {"Default_Label", type text},
				        {"Age_Group", type text},
				        {"Credit_Limit_Band", type text},
				        {"Utilization_Band", type text}
				    }),
				    Result = Typed
				in
				    Result

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

